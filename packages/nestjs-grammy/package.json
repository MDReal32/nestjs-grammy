{
  "name": "@mdreal/nestjs-grammy",
  "version": "2.0.0-next.2",
  "description": "NestJS module for building Telegram bots with grammY — decorator-driven handlers, multi-bot support, dependency injection, and polling/webhook runtimes.",
  "keywords": [
    "nestjs",
    "grammy",
    "grammyjs",
    "telegram",
    "telegram-bot",
    "bot",
    "decorators",
    "dependency-injection",
    "webhook",
    "polling",
    "typescript"
  ],
  "homepage": "https://github.com/MDReal32/nestjs-grammy#readme",
  "bugs": {
    "url": "https://github.com/MDReal32/nestjs-grammy/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MDReal32/nestjs-grammy.git"
  },
  "license": "Apache-2.0",
  "author": "MDReal",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/nestjs-grammy.d.ts",
      "import": "./build/nestjs-grammy.js",
      "require": "./build/nestjs-grammy.cjs"
    },
    "./schematics": {}
  },
  "main": "./build/nestjs-grammy.cjs",
  "module": "./build/nestjs-grammy.js",
  "types": "./build/nestjs-grammy.d.ts",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "biome check",
    "prepack": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.24",
    "grammy": "npm:@jsr/grammyjs__grammy@2.0.0-beta.8",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@swc/core": "^1.16.22",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  },
  "peerDependencies": {
    "@grammyjs/conversations": "^2.0.0",
    "@nestjs/common": "^10 || ^11 || ^12",
    "@nestjs/core": "^10 || ^11 || ^12",
    "reflect-metadata": "^0.2"
  },
  "peerDependenciesMeta": {
    "@grammyjs/conversations": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
