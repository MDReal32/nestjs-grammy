{
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": false,
    "module": "esnext",
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": "./",
    "paths": {
      "@mdreal/nestjs-grammy-testing": ["src/main.ts"]
    }
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "entrypoints/jest.d.ts",
    "entrypoints/vitest.d.ts",
    "entrypoints/bun.d.ts",
    "entrypoints/expect.d.ts",
    "entrypoints/playwright.d.ts"
  ]
}
