{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "/node_modules/.+\\.js$": [
      "ts-jest",
      { "tsconfig": { "allowJs": true, "module": "commonjs", "target": "es2022" } }
    ],
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["/node_modules/(?!(grammy|@jsr)/)"]
}
