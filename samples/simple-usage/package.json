{
  "name": "simple-usage",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "scripts": {
    "build": "nest build",
    "format": "biome check --write",
    "lint": "biome check",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test:bun": "bun --config=tests/bun/bunfig.toml test src",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config tests/jest/jest.config.js --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "test:jest": "NODE_OPTIONS=--experimental-vm-modules jest --config tests/jest/jest.config.js --passWithNoTests",
    "test:jest:cov": "NODE_OPTIONS=--experimental-vm-modules jest --config tests/jest/jest.config.js --coverage --passWithNoTests",
    "test:jest:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config tests/jest/jest.config.js --watch",
    "test:node": "tsx --test --import ./tests/node/setup.ts src/*.spec.ts",
    "test:vitest": "vitest run --config tests/vitest/vitest.config.ts"
  },
  "dependencies": {
    "@mdreal/nestjs-grammy": "workspace:^",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mdreal/nestjs-grammy-testing": "workspace:^",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.5.0",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "expect": "^30.5.2",
    "jest": "^30.5.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "~5.1.0"
  }
}
